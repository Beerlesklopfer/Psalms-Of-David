<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service looks its notification icons up by name at run time, so the resource shrinker of the release build would
     remove them and the notification with the controls (and the lock screen card) could not be built. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*" />

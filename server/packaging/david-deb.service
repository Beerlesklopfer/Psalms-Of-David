# systemd unit for the David server.
# Installed by the .deb package. Before the first start create the first administrator (see
# docs/releasing.md, "The David service"); the import folders are set in the admin pages, then
#   systemctl edit david   &&   systemctl enable --now david
[Unit]
Description=David server (audiobook and music library)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/david run
# The database lives in /var/lib/david (owned by the system user "david").
Environment=DAVID_DATA_DIR=/var/lib/david
# Listen on every interface, IPv4 and IPv6 at the same time (a list; a machine without IPv6 skips the second):
# the apps of the family reach the server over the network. Anything
# but this machine speaks TLS with a certificate David makes itself; the pairing code carries its
# fingerprint, so the apps accept only this server. Browsers warn about the certificate. To
# keep the server on this machine (say, behind nginx), set DAVID_LISTEN=127.0.0.1:8484 in a
# drop-in (`systemctl edit david`). Port 8484 must be open in the firewall.
Environment=DAVID_LISTEN=0.0.0.0:8484,[::]:8484
# The data lives in /var/lib/david, and the library in /var/lib/david/library: both belong to the
# user david, so uploads, tag editing and deleting work without any permission work. Set
# /var/lib/david/library as the import folder in the admin pages.
StateDirectory=david david/library
# The service starts as root and drops to the system user "david" (created by the package, IDs and
# settings in /etc/david.toml). Before that it gives that user the rights on the import folders
# with POSIX ACLs, so no setfacl is needed. The sandbox below must let it write there: see
# ReadWritePaths.
Restart=on-failure
# A stop (also a package update) lets a CD that is being read finish its track (up to 10 s), write down what is finished and end
# (up to 10 s more), so that the next start can resume it. The default of systemd (90 s) would do; this says it.
TimeoutStopSec=60
RestartSec=5

# The library is read, and written too: uploads are put into it, tags and covers are written
# into its files and deleted books lose their files. So the user david needs write permission
# on the folders (an owning group added with SupplementaryGroups=, or an ACL), and the sandbox
# below must let it through: ProtectSystem=strict makes everything but the state directory
# read-only. The default library (/var/lib/david/library) is open; for every other folder of the
# import settings (and for a library below /home) add a drop-in with `systemctl edit david`:
#   [Service]
#   ReadWritePaths=/srv/music /home/you/Hörbücher
#   ProtectHome=false      # only if a folder is below /home
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
# The encoder thread of a CD rip asks for the highest priority (setting cd_encoder_nice); 40 allows nice -20 to the user david.
LimitNICE=40

# The CD drive: the server reads audio CDs from /dev/sr*. Nothing here hides the device or the kernel's drive events
# (no PrivateDevices=, no RestrictAddressFamilies=); the service user needs the group of the drive in `groups` of
# /etc/david.toml (FAQ.md, "audio CDs in the drive of the server").

[Install]
WantedBy=multi-user.target

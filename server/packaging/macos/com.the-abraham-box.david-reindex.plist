<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reads the import folders again every hour and takes the albums whose files are gone out of the library (`david reindex`), the counterpart of
  packaging/david-reindex.service and .timer. The import has to be unlocked (administration pages, Import). Runs as the service account.
  By hand: sudo -u _david /usr/local/bin/david reindex
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.the-abraham-box.david-reindex</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/david</string>
		<string>reindex</string>
	</array>
	<key>UserName</key>
	<string>_david</string>
	<key>GroupName</key>
	<string>_david</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/var/empty</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
		<key>HOME</key>
		<string>/Library/Application Support/David</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/log/david-reindex.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/david-reindex.log</string>
</dict>
</plist>

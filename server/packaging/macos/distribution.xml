<?xml version="1.0" encoding="utf-8"?>
<!-- The installer of David for macOS: one package, no choices, for Macs with Apple silicon and Intel (the binary is universal), macOS 11 or newer. -->
<installer-gui-script minSpecVersion="2">
    <title>David</title>
    <organization>com.the-abraham-box</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="@ARCHITECTURES@"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.the-abraham-box.david"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.the-abraham-box.david" visible="false" title="David">
        <pkg-ref id="com.the-abraham-box.david"/>
    </choice>
    <pkg-ref id="com.the-abraham-box.david" version="@VERSION@" onConclusion="none">david-component.pkg</pkg-ref>
</installer-gui-script>

# Opens the administration pages of the David server of this machine in the browser. The service
# listens on every interface and speaks TLS with its own certificate (the browser warns once);
# change the address here if the server was set up differently.
[Desktop Entry]
Type=Application
Name=David Administration
Name[de]=David Verwaltung
GenericName=Audiobook and music server
Comment=Opens the administration pages of the David server in the browser
Comment[de]=Öffnet die Verwaltungsseiten des David-Servers im Browser
Exec=xdg-open https://localhost:8484/admin/
Icon=io.onesimus.david
Terminal=false
Categories=Settings;
Keywords=david;audiobook;hörbuch;server;admin;
